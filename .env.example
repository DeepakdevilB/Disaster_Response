# =====================================================================
# Intelligent Disaster Response Platform - environment configuration
# Copy to .env and change every "change-me" value:
#     cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored. NEVER commit real secrets.
# =====================================================================

# ---- Application ----
APP_NAME=disaster-response-api
# development | test | production  (production refuses to start with "change-me" secrets)
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json (structured, default) | console (human-readable, local debugging)
LOG_FORMAT=json
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL 16 + PostGIS + pgvector ----
# Host-side values. Inside docker compose the API overrides *_HOST with service names.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=disaster
POSTGRES_USER=disaster
POSTGRES_PASSWORD=change-me-postgres

# ---- Redis 7 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=0

# ---- RabbitMQ 3 ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=disaster
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_VHOST=disaster

# ---- MinIO (S3-compatible object storage) ----
# Host:port of the S3 API (no scheme)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=disaster-minio
# MinIO requires at least 8 characters
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_SECURE=false
MINIO_BUCKET=incident-media

# ---- Host port mappings (change if a port is already in use on your machine) ----
# All ports bind to 127.0.0.1 only.
HOST_POSTGRES_PORT=5432
HOST_REDIS_PORT=6379
HOST_RABBITMQ_PORT=5672
HOST_RABBITMQ_UI_PORT=15672
HOST_MINIO_PORT=9000
HOST_MINIO_CONSOLE_PORT=9001
HOST_API_PORT=8000

# ---- Tests ----
# Set to 1 to make integration tests FAIL (instead of skip) when Postgres is unreachable. CI sets this.
REQUIRE_INTEGRATION=0
